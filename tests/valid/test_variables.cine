// =============================================
// Teste: Declaração e uso de variáveis
// Tipos: int, float, string
// =============================================

// Declaração com inicialização
int idade = 25;
float altura = 1.75;
string nome = "CineScript";

// Declaração sem inicialização
int contador;

// Atribuição
contador = 0;

// Operações aritméticas
int soma = idade + 5;
float resultado = altura * 2.0;

// Concatenação de strings
string saudacao = "Olá, " + nome;

// Impressão
print(nome);
print(idade);
print(altura);
print(saudacao);
print(soma);
print(resultado);
