// =============================================
// Teste: Estruturas de controle - if / else
// =============================================

int nota = 85;
string resultado;

// Condicional simples
if (nota >= 90) {
    resultado = "Excelente";
} else {
    if (nota >= 70) {
        resultado = "Aprovado";
    } else {
        resultado = "Reprovado";
    }
}

print(resultado);

// Condicional com operadores lógicos
int idade = 20;
int saldo = 100;

if (idade >= 18 && saldo > 0) {
    print("Acesso permitido");
} else {
    print("Acesso negado");
}

// Comparações
int a = 10;
int b = 20;

if (a != b) {
    print("a e b são diferentes");
}

if (a < b || b == 20) {
    print("Condição OR verdadeira");
}
