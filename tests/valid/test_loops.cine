// =============================================
// Teste: Laços de repetição - while
// =============================================

// Contagem simples
int i = 0;
while (i < 5) {
    print(i);
    i = i + 1;
}

// Soma acumulada
int soma = 0;
int n = 1;
while (n <= 10) {
    soma = soma + n;
    n = n + 1;
}
print(soma);    // Deve imprimir 55

// While com condição composta
int x = 100;
int passos = 0;
while (x > 1 && passos < 20) {
    x = x / 2;
    passos = passos + 1;
}
print(passos);

// Escopo dentro do while
int total = 0;
int j = 0;
while (j < 3) {
    int parcial = j * 10;
    total = total + parcial;
    j = j + 1;
}
print(total);
